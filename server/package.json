{
  "name": "price-tracker-server",
  "version": "1.0.0",
  "description": "Backend API and scraping service for Product Price Tracker",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test --test-concurrency=1 tests/**/*.test.js",
    "db:verify": "node scripts/verify-db.js",
    "scrape:batch": "node scripts/run-reliability-batch.js",
    "scrape:cycle": "node scripts/run-cycle.js",
    "scrape:test-headless": "node scripts/test-headless-live.js",
    "scrape:watch": "node scripts/scrape-once.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "playwright": "1.51.0"
  }
}
