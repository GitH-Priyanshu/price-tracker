# Supabase Configuration (Required for database operations in B2+)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Cron Job Authentication Secret (Required for POST /api/cron/scrape)
CRON_SECRET=your-secure-random-cron-secret-here

# Target Store Base URL (Default: https://demo.inelabteamdev.com)
STORE_BASE_URL=https://demo.inelabteamdev.com

# Frontend Origin for CORS (e.g. http://localhost:5173 in dev or https://your-app.vercel.app in prod)
FRONTEND_ORIGIN=http://localhost:5173

# Server Port (Render provides this dynamically in production)
PORT=3000

# Scraper Concurrency and Reliability Budgets
REQUEST_TIMEOUT_MS=10000
MAX_ATTEMPTS=3
SCRAPE_CONCURRENCY=2
DEDUPE_WINDOW_MINUTES=10
